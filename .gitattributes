# 二进制文件不做换行转换，避免被 git 当成文本改坏
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.gz    binary
*.tar   binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.so    binary
*.dylib binary
*.pyc   binary
*.onnx  binary
*.gguf  binary
*.pt    binary
*.bin   binary
*.wav   binary
*.mp3   binary
*.mp4   binary

# 双击运行的脚本固定用 CRLF，否则某些情况下 .bat 会解析出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
